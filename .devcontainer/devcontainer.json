{
  "name": "ML Zoomcamp",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --NotebookApp.token='' > jupyter.log 2>&1 &"
}